{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "title": "resume results (ok/denied/error)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(vihs_resume_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    },
    {
      "title": "resume denial rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(vihs_resume_total{result=\"denied\"}[5m])) * 60",
          "legendFormat": "denials/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 10}]}
        }
      }
    },
    {
      "title": "authz denials",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(rate(vihs_authz_denials_total[5m]))",
          "legendFormat": "denials/min"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops"}}
    }
  ],
  "schemaVersion": 39,
  "title": "VIHS Resume / Security",
  "uid": "vihs-resume-security",
  "version": 1
}
