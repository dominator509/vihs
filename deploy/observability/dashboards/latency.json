{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {
      "title": "e2e first-audio p50/p95 (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vihs_e2e_first_audio_ms_bucket[5m])) by (le, pod_id))",
          "legendFormat": "p50 {{pod_id}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vihs_e2e_first_audio_ms_bucket[5m])) by (le, pod_id))",
          "legendFormat": "p95 {{pod_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 2000}]}
        }
      }
    },
    {
      "title": "stage first-chunk p95 (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vihs_stage_first_chunk_ms_bucket[5m])) by (le, pod_id, stage))",
          "legendFormat": "{{stage}} {{pod_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"}
      }
    },
    {
      "title": "e2e total p50/p95 (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(vihs_e2e_total_ms_bucket[5m])) by (le, pod_id))",
          "legendFormat": "p50 {{pod_id}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vihs_e2e_total_ms_bucket[5m])) by (le, pod_id))",
          "legendFormat": "p95 {{pod_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"}
      }
    }
  ],
  "schemaVersion": 39,
  "title": "VIHS Latency",
  "uid": "vihs-latency",
  "version": 1
}
