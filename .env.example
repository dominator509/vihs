# VIHS environment — copy to .env and fill. Never commit .env.
# Registry: ENVIRONMENT.md. S=secret, N=non-secret.

# --- Core services (N) ---
VIHS_REDIS_URL=redis://127.0.0.1:6379
VIHS_S3_ENDPOINT=http://127.0.0.1:9000
VIHS_S3_BUCKET=vihs-sessions
VIHS_MEMORYD_ADDR=127.0.0.1:8091
VIHS_ORCH_ADDR=0.0.0.0:8080
VIHS_ADMIN_ADDR=127.0.0.1:8081
VIHS_MCP_ADDR=127.0.0.1:8092
VIHS_POD_ADDR=127.0.0.1:8093
VIHS_POD_TOKEN=***
# VIHS_ADMIN_TOKEN=*** 32-byte b64url bootstrap admin token (EP-006 M1; must be 32 bytes decoded)

# --- Object store credentials (S, dev defaults; rotate in stage/prod) ---
VIHS_S3_ACCESS_KEY=minioadmin
VIHS_S3_SECRET_KEY=minioadmin

# --- Token hashing (S, stage/prod only; >=32 bytes decoded b64) ---
# VIHS_TOKEN_PEPPER=

# --- Scaling (ADR-010) ---
POD_MAX_SESSIONS=2
SCALE_UP_FILL=0.8
WARM_POOL_FLOOR=1
POD_COOLDOWN_SECS=300

# --- Retention / compaction ---
SESSION_TTL_DAYS=90
COMPACT_VERBATIM_TAIL=20
COMPACT_TOKEN_BUDGET=3000

# --- Provider ---
PROVIDER=mock
# RUNPOD_API_KEY=  (prod deploy only; STOP S1 at EP-009)
# PROVIDER=mock            # mock|runpod (EP-009 M2; runpod requires the key)
# VIHS_RUNPOD_IMAGE=vihs-pod:latest
# VIHS_RUNPOD_VOLUME_ID=   # network volume id mounted at /workspace/models
# VIHS_RUNPOD_REGION=      # preferred data center id (optional)
# VIHS_RUNPOD_CLOUD=SECURE # SECURE|COMMUNITY|ANY
# VIHS_RUNPOD_ENV={}       # JSON object merged into pod container env (optional)

# --- Pod (real GPU mode) ---
# VIHS_MODEL_DIR=/workspace/models
# VIHS_LLM_URL=http://127.0.0.1:8000/v1
VIHS_REAL_STAGES=0
# VIHS_MOCK_ANSWERS=["First sentence is done. Second one is longer and gets cut before finishing.", "Understood. Continuing from here."]

# --- Logging ---
RUST_LOG=info
VIHS_POD_LOG=info

# --- Client (EP-006 M5) ---
# Serve client HTML/JS from a directory instead of the embedded copy (dev).
# VIHS_CLIENT_DIR=client

# --- Observability (EP-008 M3) ---
# dev-services.sh up-obs runs prometheus + grafana (compose obs profile).
# Grafana listens on 127.0.0.1:<port>; default 3100 (3000 is taken by other
# host services on dev machines).
VIHS_OBS_PROM_PORT=9090
VIHS_OBS_GRAFANA_PORT=3100
