# VIHS environment — copy to .env and fill. Never commit .env.
# Registry: ENVIRONMENT.md. S=secret, N=non-secret.

# --- Core services (N) ---
VIHS_REDIS_URL=redis://127.0.0.1:6379
VIHS_S3_ENDPOINT=http://127.0.0.1:9000
VIHS_S3_BUCKET=vihs-sessions
VIHS_MEMORYD_ADDR=127.0.0.1:8091
VIHS_ORCH_ADDR=0.0.0.0:8080
VIHS_ADMIN_ADDR=127.0.0.1:8081

# --- Object store credentials (S, dev defaults; rotate in stage/prod) ---
VIHS_S3_ACCESS_KEY=minioadmin
VIHS_S3_SECRET_KEY=minioadmin

# --- Token hashing (S, stage/prod only; >=32 bytes decoded b64) ---
# VIHS_TOKEN_PEPPER=

# --- Scaling (ADR-010) ---
POD_MAX_SESSIONS=2
SCALE_UP_FILL=0.8
WARM_POOL_FLOOR=1
POD_COOLDOWN_SECS=300

# --- Retention / compaction ---
SESSION_TTL_DAYS=90
COMPACT_VERBATIM_TAIL=20
COMPACT_TOKEN_BUDGET=3000

# --- Provider ---
PROVIDER=mock
# RUNPOD_API_KEY=  (prod deploy only; STOP S1 at EP-009)

# --- Pod (real GPU mode) ---
# VIHS_MODEL_DIR=/workspace/models
# VIHS_LLM_URL=http://127.0.0.1:8000/v1
VIHS_REAL_STAGES=0

# --- Logging ---
RUST_LOG=info
VIHS_POD_LOG=info
